#!/bin/bash

# I would prefer to use Python3 in my terminals
alias python=python3

# venv [DIR] : create a virtualenv, defaulting to .venv
venv() {
    python3 -m venv "${1:-.venv}"
}

# activate [DIR] : activate a virtualenv; tries .venv then env when no DIR given
activate() {
    local dir
    for dir in "${1:-.venv}" env; do
        if [ -f "$dir/bin/activate" ]; then
            # shellcheck disable=SC1091
            . "$dir/bin/activate"
            return
        fi
    done
    echo "activate: no virtualenv found (looked for ${1:-.venv}/ and env/)" >&2
    return 1
}
